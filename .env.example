TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=your_bot_username
ALLOWED_CHAT_IDS=-1001234567890
ALLOW_ALL_CHATS=false
OWNER_USER_IDS=123456789
CHANNEL_CHAT_ID=-1001234567890

# Cloud LLM (recommended)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI API alternative
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key
# OPENAI_MODEL=gpt-4o-mini  # Alternatives: gpt-4o, o3-mini

# Grok (xAI) alternative
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_xai_key
# OPENAI_BASE_URL=https://api.x.ai/v1
# OPENAI_MODEL=grok-3-mini  # Alternatives: grok-3

# OpenRouter alternative
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openrouter_key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=deepseek/deepseek-r1:free

# Local Ollama alternative
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:3b-instruct  # Alternatives: llama3.2:3b, deepseek-r1:1.5b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=200

LLM_TIMEOUT_MS=30000
CHANNEL_ABOUT=Авторский Telegram-канал с постами, материалами и обсуждениями в комментариях.
AUTO_REPLY_ENABLED=true
MAX_REPLY_CHARS=260
THREAD_COOLDOWN_MS=90000
RECENT_MESSAGES_LIMIT=8
URL_FETCH_TIMEOUT_MS=8000
LOG_LEVEL=info

# Media hosting for /post (Vercel static files)
WEBSITE_REPO_PATH=D:/_CODE_2026_/portfolio-clone
MEDIA_PUBLIC_BASE_URL=https://alevoldon.com/media
MEDIA_AUTO_DEPLOY=true
